<Window x:Class="Tradentum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Tradentum.ViewModels"
        xmlns:v="clr-namespace:Tradentum.Views"
        Title="MainWindow" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:Page1ViewModel}">
            <v:Page1View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Page2ViewModel}">
            <v:Page2View/>
        </DataTemplate>

        <!-- 🔹 Компактная кнопка для статус-бара -->
        <Style x:Key="StatusBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource StatusBarForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <!-- ✅ Используем AccentBrush (кисть), а не AccentColor (цвет) -->
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 🔹 Верхнее меню -->
            <RowDefinition Height="Auto"/>
            <!-- 🔹 Шапка -->
            <RowDefinition Height="Auto"/>
            <!-- 🔹 Основная рабочая область -->
            <RowDefinition Height="*"/>
            <!-- 🔹 Строка состояния -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= МЕНЮ ================= -->
        <Menu Grid.Row="0" Background="WhiteSmoke">
            <MenuItem Header="📁 Файл">
                <MenuItem Header="⚙️ Настройки" IsEnabled="False" />
                <Separator/>
                <MenuItem Header="🚪 Выход" Command="{Binding ExitCommand}" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="👁️ Вид">
                <MenuItem Header="🌗 Сменить тему" Command="{Binding ToggleThemeCommand}" IsEnabled="False" />
                <MenuItem Header="🔄 Сбросить кэш" Command="{Binding RefreshCommand}" />
            </MenuItem>
            <MenuItem Header="❓ Справка">
                <MenuItem Header="ℹ️ О программе" Command="{Binding AboutCommand}" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <!-- ================= ШАПКА ================= -->
        <!-- 🔹 Удалена кнопка "Отключить", оставлены только навигация -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,0">

            <Button Content="Страница 1"
                    Command="{Binding NavigateToPage1Command}" 
                    Margin="8,0,0,0" 
                    MinWidth="110" 
                    Padding="8,4" 
                    IsEnabled="True"/>

            <Button Content="Страница 2" 
                    Command="{Binding NavigateToPage2Command}"
                    Margin="8,0,0,0"
                    MinWidth="110" 
                    Padding="8,4" 
                    IsEnabled="True"/>

        </StackPanel>

        <!-- ================= РАБОЧАЯ ОБЛАСТЬ ================= -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentPageViewModel}" Margin="0"/>

        <!-- ================= СТРОКА СОСТОЯНИЯ ================= -->
        <StatusBar Grid.Row="3" 
                   Background="{DynamicResource StatusBarBackground}" 
                   BorderBrush="{DynamicResource BorderBrush}" 
                   BorderThickness="0,1,0,0"
                   Padding="8,4">

            <!-- 🔹 Левая часть: Индикатор подключения и статус -->
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Fill" Value="#F44336"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" 
                               Foreground="{DynamicResource StatusBarForeground}" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>

            <!-- 🔹 Правая часть: Кнопка "Подключить" + версия -->
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- 🔹 Кнопка подключения/отключения -->
                    <Button Command="{Binding ConnectCommand}"
                            Margin="0,0,8,0">

                        <!-- 🔹 Текст кнопки меняется в зависимости от состояния -->
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🔗 Подключить"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="🔌 Отключить"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>

                        <!-- 🔹 Стиль кнопки тоже меняется -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StatusBarButtonStyle}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource StatusBarForeground}"/>
                                <Style.Triggers>
                                    <!-- При наведении -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <!-- Когда подключено → кнопка красная (для отключения) -->
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#DC3545"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#C82333"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Версия приложения -->
                    <TextBlock Text="v0.1.0-alpha" 
                               FontSize="11" 
                               Foreground="{DynamicResource StatusBarForeground}" 
                               Opacity="0.6"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>

        </StatusBar>
    </Grid>
</Window>